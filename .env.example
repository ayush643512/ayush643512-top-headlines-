# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only inside app/api routes and server components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata/sitemap/OG tags and Supabase redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
